---
export const prerender = true;
import { PROVIDER_TEMPLATES } from '../../../data/provider-templates';
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';
const canonicalUrl = `${siteOrigin}/panel/perfil`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Perfil proveedor | Reindr Marketplace MVP</title>
    <meta name="description" content="Gestion de perfil provider: datos publicos y contacto operativo." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main style="max-width: 980px; margin: 0 auto; padding: 40px 20px; font-family: system-ui, sans-serif;">
      <header style="display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap;">
        <h1 style="margin:0;">Perfil provider</h1>
        <nav style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
          <a href="/panel">Dashboard</a>
          <a href="/panel/perfil">Perfil</a>
          <a href="/panel/leads">Leads</a>
          <a id="public-page-link" href="#" target="_blank" style="background:#0b5d1e; color:#fff; padding:6px 14px; border-radius:6px; text-decoration:none; font-size:13px; display:none;">Ver mi pagina ↗</a>
          <button id="logout-btn" type="button">Cerrar sesion</button>
        </nav>
      </header>

      <p style="margin-top:8px;">Actualiza solo tu perfil autenticado con token bearer guardado en el panel.</p>

      <section style="margin-top:18px; border:1px solid #ddd; border-radius:14px; padding:16px;">
        <form id="provider-profile-form" style="display:grid; gap:10px;">
          <label>
            Nombre comercial
            <input name="display_name" required />
          </label>
          <label>
            Descripcion
            <textarea name="description" rows="4"></textarea>
          </label>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:10px;">
            <label>
              Telefono
              <input name="phone" />
            </label>
            <label>
              WhatsApp
              <input name="whatsapp" />
            </label>
          </div>
          <label>
            Web
            <input name="website_url" type="url" placeholder="https://..." />
          </label>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:10px;">
            <label>
              Logo URL
              <input name="logo_url" type="url" placeholder="https://..." />
            </label>
            <label>
              Cover URL
              <input name="cover_url" type="url" placeholder="https://..." />
            </label>
          </div>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:10px;">
            <label>
              Instagram
              <input name="instagram" placeholder="@usuario" />
            </label>
            <label>
              Facebook
              <input name="facebook" placeholder="URL pagina" />
            </label>
          </div>
          <div id="logo-preview" style="margin-top:8px;"></div>
          <label>
            Plantilla publica
            <input type="hidden" name="template_id" id="template-id-input" value="craft-paper" />
          </label>
          <div id="template-grid" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin-top:4px;">
          </div>
          <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;" id="template-filters">
            <button type="button" data-filter="all" style="padding:4px 10px; border:1px solid #ddd; border-radius:14px; background:#0b5d1e; color:#fff; cursor:pointer; font-size:12px;">Todos</button>
            <button type="button" data-filter="calido" style="padding:4px 10px; border:1px solid #ddd; border-radius:14px; background:#fff; cursor:pointer; font-size:12px;">Calidos</button>
            <button type="button" data-filter="moderno" style="padding:4px 10px; border:1px solid #ddd; border-radius:14px; background:#fff; cursor:pointer; font-size:12px;">Modernos</button>
            <button type="button" data-filter="corporativo" style="padding:4px 10px; border:1px solid #ddd; border-radius:14px; background:#fff; cursor:pointer; font-size:12px;">Corporativos</button>
            <button type="button" data-filter="creativo" style="padding:4px 10px; border:1px solid #ddd; border-radius:14px; background:#fff; cursor:pointer; font-size:12px;">Creativos</button>
            <button type="button" data-filter="minimal" style="padding:4px 10px; border:1px solid #ddd; border-radius:14px; background:#fff; cursor:pointer; font-size:12px;">Minimal</button>
          </div>
          <p id="template-desc" style="margin:8px 0 0; font-size:13px; opacity:0.7;"></p>
          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button type="button" id="load-profile-btn">Recargar perfil</button>
            <button type="submit">Guardar cambios</button>
          </div>
        </form>
        <p id="profile-status" style="margin:12px 0 0; font-size:14px;"></p>
      </section>

      <section style="margin-top:18px; border:1px solid #ddd; border-radius:14px; padding:16px;">
        <h2 style="margin-top:0;">Servicios ofrecidos</h2>
        <p style="margin-top:0;">Selecciona los servicios que ofrece tu negocio y las ciudades donde operas.</p>

        <div style="margin-bottom:12px;">
          <h3 style="font-size:14px; margin:0 0 6px;">Ciudades</h3>
          <div id="cities-checkboxes" style="display:flex; gap:12px; flex-wrap:wrap;">
            Cargando ciudades...
          </div>
        </div>

        <div style="margin-bottom:12px;">
          <h3 style="font-size:14px; margin:0 0 6px;">Servicios</h3>
          <div id="services-checkboxes" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:8px;">
            Cargando servicios...
          </div>
        </div>

        <button type="button" id="save-services-btn">Guardar servicios y ciudades</button>
        <p id="services-status" style="margin:8px 0 0; font-size:14px;"></p>
      </section>

      <section style="margin-top:18px; border:1px solid #ddd; border-radius:14px; padding:16px;">
        <h2 style="margin-top:0;">Vista previa</h2>
        <article
          id="template-preview-card"
          style="font-family:'Segoe UI',sans-serif; border:1px solid #c9c9c9; border-radius:12px; padding:20px;"
        >
          <p id="template-preview-name" style="margin:0; font-size:12px; text-transform:uppercase; letter-spacing:.08em; opacity:0.5;">Template</p>
          <h3 id="template-preview-title" style="margin:8px 0;">Nombre Comercial</h3>
          <p id="template-preview-desc" style="margin:0 0 10px;">Descripcion breve de ejemplo para visualizar tono y contraste.</p>
          <div style="margin-top:12px; background:rgba(255,255,255,0.85); border:1px solid #c9c9c9; border-radius:10px; padding:10px; font-size:14px;">
            <strong>Servicios:</strong> <span id="template-preview-services">-</span>
          </div>
        </article>
      </section>

      <section style="margin-top:18px; border:1px solid #ddd; border-radius:14px; padding:16px;">
        <h2 style="margin-top:0;">Personalizar plantilla</h2>
        <p style="margin-top:0; font-size:13px; opacity:0.7;">Ajusta colores y tipografia de tu plantilla. Estos cambios se guardan por separado y no afectan la plantilla base.</p>
        <div id="customizer-fields" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; margin-bottom:12px;">
        </div>
        <button type="button" id="save-custom-styles-btn" style="padding:8px 16px; background:#0b5d1e; color:#fff; border:none; border-radius:6px; cursor:pointer;">Guardar personalizacion</button>
        <button type="button" id="reset-custom-styles-btn" style="padding:8px 16px; background:#f0f0f0; border:1px solid #ddd; border-radius:6px; cursor:pointer; margin-left:8px;">Restaurar defaults</button>
        <p id="custom-styles-status" style="font-size:13px; margin:6px 0 0;"></p>
      </section>
    </main>


    <script is:inline>
      (async () => {
        try {
          const apiBase = window.location.origin.includes('localhost') ? 'http://localhost:8787' : 'https://apps.reindr.org';
          const res = await fetch(apiBase + '/api/templates');
          if (res.ok) {
            const json = await res.json();
            if (json.data && json.data.length > 0) {
              window.__TEMPLATES_API__ = json.data.map((t: any) => ({
                id: t.id, name: t.name, description: t.description,
                tags: t.tags || [], category: t.category || 'moderno',
                fontStack: t.font_stack, headingFont: t.heading_font, bodyFont: t.body_font,
                bgStart: t.bg_start, bgEnd: t.bg_end, textColor: t.text_color,
                accentColor: t.accent_color, cardBackground: t.card_background,
                borderColor: t.border_color, customizable: t.customizable || []
              }));
            }
          }
        } catch {}
      })();
    </script>

    <script>
      import {
        apiRequest,
        clearStoredAccessToken,
        ensureProviderSession,
        providerAuthHeaders
      } from '../../../scripts/provider-panel-client';
      import { PROVIDER_TEMPLATES } from '../../../data/provider-templates';

      type ProviderProfilePayload = {
        id?: string;
        slug?: string;
        display_name?: string;
        description?: string | null;
        phone?: string | null;
        whatsapp?: string | null;
        website_url?: string | null;
        logo_url?: string | null;
        cover_url?: string | null;
        template_id?: string | null;
      };

      type ProviderTemplate = {
        id: string; name: string; description: string; tags: string[]; category: string;
        fontStack: string; headingFont: string; bodyFont: string;
        bgStart: string; bgEnd: string; textColor: string; accentColor: string;
        cardBackground: string; borderColor: string; customizable: string[];
      };

      const form = document.querySelector<HTMLFormElement>('#provider-profile-form');
      const loadButton = document.querySelector<HTMLButtonElement>('#load-profile-btn');
      const logoutButton = document.querySelector<HTMLButtonElement>('#logout-btn');
      const statusEl = document.querySelector<HTMLElement>('#profile-status');
      const templatePreviewCard = document.querySelector<HTMLElement>('#template-preview-card');
      const templatePreviewName = document.querySelector<HTMLElement>('#template-preview-name');
      const providerTemplates: ProviderTemplate[] = PROVIDER_TEMPLATES as unknown as ProviderTemplate[];

      function setStatus(message: string, tone: 'neutral' | 'error' | 'ok' = 'neutral') {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.style.color = tone === 'error' ? '#a40000' : tone === 'ok' ? '#0b5d1e' : '#333';
      }

      function applyTemplatePreview(templateId: string | null | undefined) {
        const card = document.querySelector<HTMLElement>('#template-preview-card');
        const nameEl = document.querySelector<HTMLElement>('#template-preview-name');
        const titleEl = document.querySelector<HTMLElement>('#template-preview-title');
        const descEl = document.querySelector<HTMLElement>('#template-preview-desc');
        const svcEl = document.querySelector<HTMLElement>('#template-preview-services');
        const descLabel = document.querySelector<HTMLElement>('#template-desc');
        if (!card) return;

        const selected = providerTemplates.find((t) => t.id === templateId) ?? providerTemplates[0];
        if (!selected) return;

        card.style.fontFamily = selected.fontStack;
        card.style.background = `linear-gradient(150deg, ${selected.bgStart}, ${selected.bgEnd})`;
        card.style.color = selected.textColor;
        card.style.borderColor = selected.borderColor;
        if (nameEl) nameEl.textContent = `Template: ${selected.name}`;
        if (descLabel) descLabel.textContent = selected.description;

        const displayName = (form?.elements?.namedItem('display_name') as HTMLInputElement)?.value?.trim();
        const desc = (form?.elements?.namedItem('description') as HTMLTextAreaElement)?.value?.trim();
        if (titleEl) titleEl.textContent = displayName || 'Nombre de tu negocio';
        if (descEl) descEl.textContent = desc || 'Descripcion de ejemplo para visualizar tono y contraste.';
        if (svcEl) {
          const checked = Array.from(document.querySelectorAll<HTMLInputElement>('#services-checkboxes input:checked') ?? []).map(el => {
            const label = el.closest('label')?.textContent?.trim() ?? el.value;
            return label;
          });
          svcEl.textContent = checked.length > 0 ? checked.join(', ') : '-';
        }
      }

      let activeFilter = 'all';

      function renderTemplateGrid() {
        const grid = document.querySelector('#template-grid');
        const input = document.querySelector<HTMLInputElement>('#template-id-input');
        if (!grid || !input) return;

        const filtered = activeFilter === 'all'
          ? providerTemplates
          : providerTemplates.filter(t => t.category === activeFilter);

        grid.innerHTML = filtered.map(t => {
          const isSelected = input.value === t.id;
          return `<button type="button" data-template="${t.id}"
            style="text-align:left; padding:10px; border:2px solid ${isSelected ? t.accentColor : '#ddd'}; border-radius:8px; background:linear-gradient(150deg,${t.bgStart},${t.bgEnd}); cursor:pointer; font-family:${t.fontStack}; color:${t.textColor};"
            title="${t.description}">
            <strong style="font-size:14px;">${t.name}</strong>
            <p style="font-size:11px; margin:4px 0 0; opacity:0.7;">${t.description.slice(0, 55)}</p>
            <span style="font-size:10px; opacity:0.5;">${t.tags.slice(0,2).map((tg: string) => '#'+tg).join(' ')}</span>
          </button>`;
        }).join('');

        grid.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('click', () => {
            const tid = btn.dataset.template ?? '';
            input.value = tid;
            applyTemplatePreview(tid);
      async function loadPublicUrl() {
        const session = await ensureProviderSession({ redirectToLogin: true });
        if (!session.ok) return;
        const result = await apiRequest<{ slug: string }>('/api/provider/me', { headers: { ...providerAuthHeaders() } });
        if (result.ok && result.data) {
          const link = document.querySelector<HTMLAnchorElement>('#public-page-link');
          if (link) { link.href = `https://apps.reindr.org/proveedores/${result.data.slug}`; link.style.display = 'inline'; }
        }
      }

      renderTemplateGrid();
          });
        });
      }

      document.querySelector('#template-filters')?.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#template-filters button').forEach(b => {
            b.style.background = '#fff'; b.style.color = '#333';
          });
          btn.style.background = '#0b5d1e'; btn.style.color = '#fff';
          activeFilter = btn.dataset.filter ?? 'all';
          renderTemplateGrid();
        });
      });

      function fillForm(profile: ProviderProfilePayload) {
        const set = (name: string, value: string | null | undefined) => {
          const field = form?.elements?.namedItem(name);
          if (field && 'value' in field) field.value = value ?? '';
        };
        set('display_name', profile.display_name);
        set('description', profile.description);
        set('phone', profile.phone);
        set('whatsapp', profile.whatsapp);
        set('website_url', profile.website_url);
        set('logo_url', profile.logo_url);
        set('cover_url', profile.cover_url);
        set('template_id', profile.template_id);
        set('instagram', profile.instagram);
        set('facebook', profile.facebook);
        applyTemplatePreview(profile.template_id);
        renderTemplateGrid();
        showLogoPreview(String(profile.logo_url ?? ''));
      }

      function showLogoPreview(url: string) {
        const el = document.querySelector('#logo-preview');
        if (!el) return;
        if (url && (url.endsWith('.jpg') || url.endsWith('.png') || url.endsWith('.webp') || url.endsWith('.jpeg') || url.includes('http'))) {
          el.innerHTML = `<img src="${url}" style="max-width:120px; max-height:80px; border-radius:8px; border:1px solid #ddd;" onerror="this.style.display='none'" />`;
        } else {
          el.innerHTML = '';
        }
      }

      document.querySelector<HTMLInputElement>('[name="logo_url"]')?.addEventListener('input', function() {
        showLogoPreview(this.value);
      });

      async function loadProfile() {
        const session = await ensureProviderSession({
          redirectToLogin: true
        });
        if (!session.ok) return;

        const result = await apiRequest('/api/provider/me', {
          headers: {
            ...providerAuthHeaders()
          }
        });

        if (!result.ok) {
          setStatus('No se pudo cargar perfil. Verifica sesion provider.', 'error');
          return;
        }

        fillForm((result.data ?? {}) as ProviderProfilePayload);
        setStatus('Perfil cargado.', 'ok');
      }

      loadButton?.addEventListener('click', () => {
        loadProfile();
      });

      // Update preview when profile fields change
      form?.querySelectorAll('input, textarea').forEach(el => {
        el.addEventListener('input', () => {
          const tid = document.querySelector<HTMLInputElement>('#template-id-input')?.value;
          applyTemplatePreview(tid);
        });
      });

      // Update preview when services checkboxes change
      document.querySelector('#services-checkboxes')?.addEventListener('change', () => {
        const tid = document.querySelector<HTMLInputElement>('#template-id-input')?.value;
        applyTemplatePreview(tid);
      });

      logoutButton?.addEventListener('click', () => {
        clearStoredAccessToken();
        window.location.href = '/panel/login';
      });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const session = await ensureProviderSession({
          redirectToLogin: true
        });
        if (!session.ok) return;

        const formData = new FormData(form);
        const payload = {
          display_name: String(formData.get('display_name') ?? '').trim(),
          description: String(formData.get('description') ?? '').trim(),
          phone: String(formData.get('phone') ?? '').trim(),
          whatsapp: String(formData.get('whatsapp') ?? '').trim(),
          website_url: String(formData.get('website_url') ?? '').trim(),
          logo_url: String(formData.get('logo_url') ?? '').trim(),
          cover_url: String(formData.get('cover_url') ?? '').trim(),
          instagram: String(formData.get('instagram') ?? '').trim(),
          facebook: String(formData.get('facebook') ?? '').trim(),
          template_id: (document.querySelector<HTMLInputElement>('#template-id-input')?.value ?? '').trim()
        };

        const result = await apiRequest('/api/provider/me', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            ...providerAuthHeaders()
          },
          body: JSON.stringify(payload)
        });

        if (!result.ok) {
          setStatus('No se pudo guardar perfil. Revisa datos y sesion.', 'error');
          return;
        }

          fillForm((result.data ?? payload) as ProviderProfilePayload);
          setStatus('Perfil actualizado correctamente.', 'ok');
      });

      // ── Custom styles editor ──────────────────────────────────────
      const FONT_OPTIONS = [
        { value: '"Segoe UI", system-ui, sans-serif', label: 'Sistema (Segoe UI)' },
        { value: '"Georgia", "Times New Roman", serif', label: 'Serif (Georgia)' },
        { value: '"Trebuchet MS", "Gill Sans", sans-serif', label: 'Art Deco (Trebuchet)' },
        { value: '"Franklin Gothic Medium", "Arial Narrow", sans-serif', label: 'Bold Narrow (Franklin)' },
        { value: '"Century Gothic", "Segoe UI", sans-serif', label: 'Clean (Century Gothic)' },
        { value: '"Courier New", monospace', label: 'Mono (Courier)' },
        { value: '"Helvetica Neue", "Arial", sans-serif', label: 'Swiss (Helvetica)' },
        { value: '"Garamond", "Georgia", serif', label: 'Clasico (Garamond)' },
        { value: '"Verdana", "Segoe UI", sans-serif', label: 'Legible (Verdana)' }
      ];

      let currentCustomStyles: Record<string, string> = {};
      let currentTemplateId = '';

      function renderCustomizer() {
        const container = document.querySelector('#customizer-fields');
        const template = providerTemplates.find(t => t.id === currentTemplateId);
        if (!container || !template) { if (container) container.innerHTML = '<p style="opacity:0.5;">Selecciona una plantilla para personalizar.</p>'; return; }

        const customizable = (template as any).customizable || ['accentColor', 'bgStart', 'bgEnd', 'textColor'];
        const fields: string[] = [];

        if (customizable.includes('accentColor')) fields.push('accentColor');
        if (customizable.includes('bgStart')) fields.push('bgStart');
        if (customizable.includes('bgEnd')) fields.push('bgEnd');
        if (customizable.includes('textColor')) fields.push('textColor');
        if (customizable.includes('headingFont')) fields.push('headingFont');
        if (customizable.includes('bodyFont')) fields.push('bodyFont');

        const labels: Record<string, string> = {
          accentColor: 'Color de acento', bgStart: 'Fondo inicio', bgEnd: 'Fondo fin',
          textColor: 'Color de texto', headingFont: 'Fuente de titulos', bodyFont: 'Fuente de texto'
        };
        const defaults: Record<string, string> = {
          accentColor: template.accentColor, bgStart: template.bgStart, bgEnd: template.bgEnd,
          textColor: template.textColor, headingFont: (template as any).headingFont || template.fontStack,
          bodyFont: (template as any).bodyFont || template.fontStack
        };

        container.innerHTML = fields.map(f => {
          const value = currentCustomStyles[f] || defaults[f] || '';
          if (f.includes('Font')) {
            const opts = FONT_OPTIONS.map(o => `<option value="${o.value}" ${o.value === value ? 'selected' : ''}>${o.label}</option>`).join('');
            return `<label style="font-size:13px;">${labels[f]} <select data-custom="${f}" style="width:100%; padding:4px; border:1px solid #ddd; border-radius:4px;">${opts}</select></label>`;
          }
          return `<label style="font-size:13px;">${labels[f]} <input type="color" data-custom="${f}" value="${value}" style="width:100%; height:32px; border:1px solid #ddd; border-radius:4px; cursor:pointer;" /></label>`;
        }).join('');

        container.querySelectorAll('input, select').forEach(el => {
          el.addEventListener('input', () => {
            const key = el.dataset.custom;
            const value = (el as HTMLInputElement|HTMLSelectElement).value;
            if (key) {
              currentCustomStyles[key] = value;
              applyCustomStylesToPreview();
            }
          });
        });
      }

      function applyCustomStylesToPreview() {
        const card = document.querySelector<HTMLElement>('#template-preview-card');
        if (!card) return;

        const template = providerTemplates.find(t => t.id === currentTemplateId);
        if (!template) return;

        const hEl = card.querySelector('h3') as HTMLElement;
        const pEl = card.querySelector('p') as HTMLElement;

        card.style.background = `linear-gradient(150deg, ${currentCustomStyles.bgStart || template.bgStart}, ${currentCustomStyles.bgEnd || template.bgEnd})`;
        card.style.color = currentCustomStyles.textColor || template.textColor;
        card.style.borderColor = currentCustomStyles.accentColor || template.accentColor;
        card.style.fontFamily = currentCustomStyles.bodyFont || (template as any).bodyFont || template.fontStack;
        if (hEl) hEl.style.fontFamily = currentCustomStyles.headingFont || (template as any).headingFont || template.fontStack;
        if (hEl) hEl.style.color = currentCustomStyles.accentColor || template.accentColor;
      }

      document.querySelector('#save-custom-styles-btn')?.addEventListener('click', async () => {
        const session = await ensureProviderSession({ redirectToLogin: true });
        if (!session.ok) return;
        const status = document.querySelector('#custom-styles-status');
        const result = await apiRequest('/api/provider/me', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', ...providerAuthHeaders() },
          body: JSON.stringify({ custom_styles: currentCustomStyles })
        });
        if (status) {
          status.textContent = result.ok ? 'Personalizacion guardada.' : 'Error al guardar.';
          status.style.color = result.ok ? '#0b5d1e' : '#a40000';
        }
      });

      document.querySelector('#reset-custom-styles-btn')?.addEventListener('click', () => {
        currentCustomStyles = {};
        renderCustomizer();
        applyCustomStylesToPreview();
        const input = document.querySelector<HTMLInputElement>('#template-id-input');
        if (input) applyTemplatePreview(input.value);
      });

      async function loadCustomStyles() {
        const session = await ensureProviderSession({ redirectToLogin: true });
        if (!session.ok) return;
        const result = await apiRequest<{ custom_styles: Record<string,string>; template_id: string }>('/api/provider/me', {
          headers: { ...providerAuthHeaders() }
        });
        if (result.ok && result.data) {
          currentCustomStyles = result.data.custom_styles ?? {};
          currentTemplateId = result.data.template_id ?? '';
          renderCustomizer();
          applyCustomStylesToPreview();
        }
        const tidInput = document.querySelector<HTMLInputElement>('#template-id-input');
        if (tidInput) {
          tidInput.addEventListener('change', () => {
            currentTemplateId = tidInput.value;
            renderCustomizer();
            applyCustomStylesToPreview();
          });
        }
      }
      type ServiceItem = { id: string; slug: string; name: string; status: string };
      type LocationItem = { id: string; slug: string; name: string; type: string };
      let availableServices: ServiceItem[] = [];
      let availableCities: LocationItem[] = [];
      let currentServiceSlugs: string[] = [];
      let currentCitySlugs: string[] = ['bogota'];

      const servicesContainer = document.querySelector<HTMLElement>('#services-checkboxes');
      const citiesContainer = document.querySelector<HTMLElement>('#cities-checkboxes');
      const saveServicesBtn = document.querySelector<HTMLButtonElement>('#save-services-btn');
      const servicesStatusEl = document.querySelector<HTMLElement>('#services-status');

      function setServicesStatus(message: string, tone: 'neutral' | 'error' | 'ok' = 'neutral') {
        if (!servicesStatusEl) return;
        servicesStatusEl.textContent = message;
        servicesStatusEl.style.color = tone === 'error' ? '#a40000' : tone === 'ok' ? '#0b5d1e' : '#333';
      }

      function renderServiceCheckboxes() {
        if (!servicesContainer) return;
        servicesContainer.innerHTML = availableServices.map((svc) => {
          const checked = currentServiceSlugs.includes(svc.slug) ? ' checked' : '';
          return `<label style="font-size:14px;">
            <input type="checkbox" name="service_slug" value="${svc.slug}"${checked} />
            ${svc.name}
          </label>`;
        }).join('');
      }

      function renderCityCheckboxes() {
        if (!citiesContainer) return;
        citiesContainer.innerHTML = availableCities.map((city) => {
          const checked = currentCitySlugs.includes(city.slug) ? ' checked' : '';
          return `<label style="font-size:14px;">
            <input type="checkbox" name="city_slug" value="${city.slug}"${checked} />
            ${city.name}
          </label>`;
        }).join('');
      }

      saveServicesBtn?.addEventListener('click', async () => {
        const session = await ensureProviderSession({ redirectToLogin: true });
        if (!session.ok) return;

        const checkedServices = Array.from(
          servicesContainer?.querySelectorAll<HTMLInputElement>('input[name="service_slug"]:checked') ?? []
        ).map((el) => el.value);

        const checkedCities = Array.from(
          citiesContainer?.querySelectorAll<HTMLInputElement>('input[name="city_slug"]:checked') ?? []
        ).map((el) => el.value);

        const result = await apiRequest('/api/provider/me/services', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', ...providerAuthHeaders() },
          body: JSON.stringify({ services: checkedServices, cities: checkedCities })
        });

        if (result.ok) {
          currentServiceSlugs = checkedServices;
          currentCitySlugs = checkedCities;
          setServicesStatus('Servicios y ciudades guardados.', 'ok');
        } else {
          setServicesStatus('Error al guardar.', 'error');
        }
      });

      async function loadServices() {
        const session = await ensureProviderSession({ redirectToLogin: true });
        if (!session.ok) return;

        const [svcResult, locResult, profileResult] = await Promise.all([
          apiRequest<ServiceItem[]>('/api/admin/services', { headers: { ...providerAuthHeaders() } }),
          apiRequest<LocationItem[]>('/api/locations?type=city', { headers: { ...providerAuthHeaders() } }),
          apiRequest<{ services: string[]; cities?: string[] }>('/api/provider/me', { headers: { ...providerAuthHeaders() } })
        ]);

        if (svcResult.ok && svcResult.data) {
          availableServices = svcResult.data.filter((s) => s.status === 'active');
        }
        if (locResult.ok && locResult.data) {
          availableCities = locResult.data;
        }
        if (profileResult.ok && profileResult.data) {
          currentServiceSlugs = profileResult.data.services ?? [];
          currentCitySlugs = profileResult.data.cities ?? ['bogota'];
        }

        renderServiceCheckboxes();
        renderCityCheckboxes();
      }

      renderTemplateGrid();
      applyTemplatePreview(null);
      renderTemplateGrid();
      loadProfile();
      loadServices();
      loadCustomStyles();
      loadPublicUrl();
    </script>
  </body>
</html>
