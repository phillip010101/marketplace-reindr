---
export const prerender = true;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';
const canonicalUrl = `${siteOrigin}/panel/registro`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Registro proveedor | Reindr Marketplace</title>
    <meta name="description" content="Crea tu cuenta de proveedor en el marketplace Reindr." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width" />
    <style is:inline>
      .btn{display:inline-block;padding:10px 20px;border:none;border-radius:6px;font-size:.875rem;font-weight:600;cursor:pointer;text-decoration:none;text-align:center;transition:all .15s}
      .btn-primary{background:#0b5d1e;color:#fff}.btn-primary:hover{filter:brightness(0.9)}
      .btn-secondary{background:#fff;color:#333;border:1px solid #ddd}
      .input{width:100%;padding:8px;border:1px solid #ddd;border-radius:6px;font-size:1rem;font-family:inherit;box-sizing:border-box}
      .input:focus{outline:none;border-color:#0b5d1e;box-shadow:0 0 0 3px rgba(11,93,30,0.1)}
    </style>
  </head>
  <body style="margin:0; background:#f2f4f7;">
    <main style="min-height:100vh; display:grid; place-items:center; padding:20px; font-family:system-ui,sans-serif;">
      <section style="width:min(480px,100%); background:#fff; border:1px solid #dde2ea; border-radius:14px; padding:24px;">
        <h1 style="margin-top:0;">Crear cuenta proveedor</h1>
        <p style="margin-top:0; opacity:0.7;">Registrate para ofrecer tus servicios en el marketplace.</p>

        <form id="register-form" style="display:grid; gap:10px;">
          <label>
            Nombre de tu negocio *
            <input type="text" name="display_name" required minlength="2" maxlength="120" class="input" />
          </label>
          <label>
            Email *
            <input type="email" name="email" required class="input" />
          </label>
          <label>
            Contraseña *
            <input type="password" name="password" required minlength="8" class="input" />
            <small style="opacity:0.6;">Minimo 8 caracteres.</small>
          </label>
          <label>
            Repetir contraseña *
            <input type="password" name="password_confirm" required minlength="8" class="input" />
          </label>
          <label style="font-size:13px; display:flex; align-items:flex-start; gap:6px;">
            <input type="checkbox" name="terms" required style="margin-top:3px;" />
            <span>Acepto los <a href="/terminos" target="_blank" style="color:#0b5d1e;">terminos y condiciones</a> y la <a href="/privacidad" target="_blank" style="color:#0b5d1e;">politica de privacidad</a>.</span>
          </label>
          <button type="submit" class="btn btn-primary" style="width:100%; font-size:15px;">Crear cuenta y entrar al panel</button>
        </form>

        <p id="register-status" style="margin:12px 0 0; font-size:14px;"></p>

        <p style="margin-top:20px; font-size:14px; border-top:1px solid #eee; padding-top:16px;">
          ¿Ya tenes cuenta? <a href="/panel/login" style="color:#0b5d1e;">Inicia sesion</a>
        </p>
      </section>
    </main>

    <script>
      import {
        apiRequest,
        setStoredAccessToken
      } from '../../../scripts/provider-panel-client';

      type RegisterResponse = {
        access_token: string;
        provider: { slug: string; display_name: string };
      };

      const form = document.querySelector<HTMLFormElement>('#register-form');
      const statusEl = document.querySelector<HTMLElement>('#register-status');

      function setStatus(message: string, tone: 'neutral' | 'error' | 'ok' = 'neutral') {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.style.color = tone === 'error' ? '#a40000' : tone === 'ok' ? '#0b5d1e' : '#333';
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (btn) { btn.disabled = true; btn.textContent = 'Creando cuenta...'; }
        const formData = new FormData(form);
        const email = String(formData.get('email') ?? '').trim();
        const password = String(formData.get('password') ?? '');
        const passwordConfirm = String(formData.get('password_confirm') ?? '');
        const display_name = String(formData.get('display_name') ?? '').trim();

        function resetBtn() { if (btn) { btn.disabled = false; btn.textContent = 'Crear cuenta y entrar al panel'; } }

        if (!display_name || display_name.length < 2) { resetBtn(); setStatus('Ingresa el nombre de tu negocio.', 'error'); return; }
        if (!email || !email.includes('@')) { resetBtn(); setStatus('Ingresa un email valido.', 'error'); return; }
        if (password.length < 8) { resetBtn(); setStatus('La contraseña debe tener al menos 8 caracteres.', 'error'); return; }
        if (password !== passwordConfirm) { resetBtn(); setStatus('Las contraseñas no coinciden.', 'error'); return; }

        try {
          const result = await apiRequest<RegisterResponse>('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password, display_name })
          });

          if (!result.ok) {
            resetBtn();
            const msg = result.error && typeof result.error === 'object' && 'message' in (result.error as any)
              ? (result.error as any).message
              : 'Error al crear la cuenta. Intenta de nuevo.';
            setStatus(msg, 'error');
            return;
          }

          setStoredAccessToken(result.data?.access_token ?? '');
          setStatus('Cuenta creada. Redirigiendo...', 'ok');
          window.location.href = '/panel';
        } catch {
          resetBtn();
          setStatus('Error de conexion. Verifica tu internet.', 'error');
        }
      });
    </script>
  </body>
</html>
