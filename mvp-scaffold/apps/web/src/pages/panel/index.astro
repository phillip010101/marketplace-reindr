---
export const prerender = true;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';
const canonicalUrl = `${siteOrigin}/panel`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Panel proveedor | Reindr Marketplace MVP</title>
    <meta
      name="description"
      content="Panel operativo para proveedores: acceso, metricas base y atajos de gestion."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main style="max-width: 1080px; margin: 0 auto; padding: 40px 20px; font-family: system-ui, sans-serif;">
      <header style="display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap;">
        <div>
          <p style="margin:0; text-transform:uppercase; letter-spacing:.08em; font-size:12px;">Provider workspace</p>
          <h1 style="margin:8px 0 0;">Panel proveedor</h1>
        </div>
        <nav style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
          <a href="/panel">Dashboard</a>
          <a href="/panel/perfil">Perfil</a>
          <a href="/panel/leads">Leads</a>
          <button id="logout-btn" type="button">Cerrar sesion</button>
        </nav>
      </header>

      <section style="margin-top:20px; border:1px solid #ddd; border-radius:14px; padding:16px;">
        <h2 style="margin-top:0;">Sesion</h2>
        <p style="margin-top:0;">Panel protegido por autenticacion provider (bearer token).</p>
        <p id="auth-status" style="margin:12px 0 0; font-size:14px;"></p>
      </section>

      <section style="margin-top:24px;">
        <h2>Wallet</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px;">
          <article style="border:1px solid #ddd; border-radius:12px; padding:14px;">
            <p style="margin:0; font-size:13px;">Saldo disponible</p>
            <strong id="wallet-balance" style="font-size:28px; color:#0b5d1e;">-</strong>
          </article>
        </div>
        <div id="wallet-transactions" style="margin-top:12px; font-size:13px;"></div>
        <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
          <input id="topup-amount" type="number" placeholder="Monto COP" min="1000" max="10000000" style="padding:6px; width:140px;" />
          <button id="topup-btn" type="button" style="padding:8px 16px; background:#0b5d1e; color:#fff; border:none; border-radius:6px; cursor:pointer;">Cargar saldo</button>
        </div>
        <p id="wallet-status" style="font-size:13px; margin:6px 0 0;"></p>
      </section>

      <section style="margin-top:24px;">
        <h2>Metricas rapidas</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px;">
          <article style="border:1px solid #ddd; border-radius:12px; padding:14px;">
            <p style="margin:0; font-size:13px;">Leads nuevos</p>
            <strong id="metric-new" style="font-size:28px;">-</strong>
          </article>
          <article style="border:1px solid #ddd; border-radius:12px; padding:14px;">
            <p style="margin:0; font-size:13px;">Leads contactados</p>
            <strong id="metric-contacted" style="font-size:28px;">-</strong>
          </article>
          <article style="border:1px solid #ddd; border-radius:12px; padding:14px;">
            <p style="margin:0; font-size:13px;">Cotizaciones enviadas</p>
            <strong id="metric-quoted" style="font-size:28px;">-</strong>
          </article>
          <article style="border:1px solid #ddd; border-radius:12px; padding:14px;">
            <p style="margin:0; font-size:13px;">Cierres reportados</p>
            <strong id="metric-closed" style="font-size:28px;">-</strong>
          </article>
        </div>
      </section>

      <section style="margin-top:24px; border:1px solid #ddd; border-radius:12px; padding:16px;">
        <h2 style="margin-top:0;">Completitud del perfil</h2>
        <div id="profile-checklist" style="display:grid; gap:8px;">
          Cargando...
        </div>
        <p style="margin-top:12px;"><a href="/panel/perfil">Ir al editor de perfil</a></p>
      </section>
    </main>

    <script>
      import {
        apiRequest,
        ensureProviderSession,
        clearStoredAccessToken,
        providerAuthHeaders
      } from '../../scripts/provider-panel-client';

      type ProviderMetrics = {
        total: number;
        new: number;
        contacted: number;
        quoted: number;
        closed: number;
      };

      const logoutButton = document.querySelector<HTMLButtonElement>('#logout-btn');
      const authStatus = document.querySelector<HTMLElement>('#auth-status');
      const metricNew = document.querySelector<HTMLElement>('#metric-new');
      const metricContacted = document.querySelector<HTMLElement>('#metric-contacted');
      const metricQuoted = document.querySelector<HTMLElement>('#metric-quoted');
      const metricClosed = document.querySelector<HTMLElement>('#metric-closed');

      function setStatus(message: string, tone: 'neutral' | 'error' | 'ok' = 'neutral') {
        if (!authStatus) return;
        authStatus.textContent = message;
        authStatus.style.color = tone === 'error' ? '#a40000' : tone === 'ok' ? '#0b5d1e' : '#333';
      }

      function setMetrics(metrics: ProviderMetrics) {
        if (metricNew) metricNew.textContent = String(metrics.new);
        if (metricContacted) metricContacted.textContent = String(metrics.contacted);
        if (metricQuoted) metricQuoted.textContent = String(metrics.quoted);
        if (metricClosed) metricClosed.textContent = String(metrics.closed);
      }

      async function refreshMetrics() {
        const session = await ensureProviderSession({
          redirectToLogin: true
        });
        if (!session.ok) {
          return;
        }

        const result = await apiRequest<ProviderMetrics>('/api/provider/metrics', {
          headers: {
            ...providerAuthHeaders()
          }
        });

        if (!result.ok) {
          setStatus('No se pudieron cargar metricas. Verifica token provider.', 'error');
          return;
        }

        const metrics = (result.data ?? {
          total: 0,
          new: 0,
          contacted: 0,
          quoted: 0,
          closed: 0
        }) as ProviderMetrics;
        setMetrics(metrics);
        setStatus(`Sesion activa. Oportunidades cargadas: ${metrics.total}.`, 'ok');
      }

      type ProviderProfile = {
        display_name?: string;
        description?: string;
        phone?: string;
        services?: string[];
        template_id?: string;
      };

      async function refreshChecklist() {
        const checklist = document.querySelector('#profile-checklist');
        if (!checklist) return;

        const session = await ensureProviderSession({ redirectToLogin: true });
        if (!session.ok) return;

        const result = await apiRequest<ProviderProfile>('/api/provider/me', {
          headers: { ...providerAuthHeaders() }
        });

        if (!result.ok || !result.data) {
          checklist.innerHTML = '<p>No se pudo cargar el perfil.</p>';
          return;
        }

        const p = result.data;
        const items = [
          { label: 'Nombre comercial', done: !!(p.display_name && p.display_name.length >= 2) },
          { label: 'Descripcion', done: !!(p.description && p.description.length >= 10) },
          { label: 'Telefono o WhatsApp', done: !!(p.phone || p.whatsapp) },
          { label: 'Plantilla visual', done: !!(p.template_id && p.template_id !== 'craft-paper') },
          { label: 'Servicios ofrecidos', done: !!(p.services && p.services.length > 0) },
          { label: 'Ciudades de cobertura', done: !!(p.cities && p.cities.length > 0) }
        ];

        const doneCount = items.filter(i => i.done).length;
        const pct = Math.round((doneCount / items.length) * 100);

        checklist.innerHTML = `
          <div style="margin-bottom:8px;">
            <strong>${doneCount}/${items.length} completado (${pct}%)</strong>
            <div style="background:#e0e0e0; border-radius:4px; height:8px; margin-top:4px;">
              <div style="background:#0b5d1e; border-radius:4px; height:8px; width:${pct}%;"></div>
            </div>
          </div>
          ${items.map(i => `<div style="font-size:14px;">${i.done ? '✅' : '⬜'} ${i.label}${i.done ? '' : ' <a href="/panel/perfil" style="font-size:12px;">(completar)</a>'}</div>`).join('')}
        `;
      }

      async function refreshWallet() {
        const session = await ensureProviderSession({ redirectToLogin: true });
        if (!session.ok) return;

        const result = await apiRequest<{ balance: number; transactions: { type: string; amount: number; reason: string; created_at: string }[] }>('/api/provider/wallet', {
          headers: { ...providerAuthHeaders() }
        });

        const balanceEl = document.querySelector('#wallet-balance');
        const txEl = document.querySelector('#wallet-transactions');

        if (result.ok && result.data) {
          if (balanceEl) {
            balanceEl.textContent = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(result.data.balance);
          }
          if (txEl && result.data.transactions.length > 0) {
            txEl.innerHTML = '<p style="margin:4px 0; opacity:0.7;">Ultimos movimientos:</p>' + result.data.transactions.slice(0, 5).map(t => {
              const sign = t.type === 'credit' || t.type === 'refund' ? '+' : '-';
              const color = t.type === 'debit' ? '#a40000' : '#0b5d1e';
              return `<div style="color:${color}; margin:2px 0;">${sign}$${t.amount.toLocaleString()} — ${t.reason} — ${new Date(t.created_at).toLocaleDateString('es-CO')}</div>`;
            }).join('');
          }
        }
      }

      document.querySelector('#topup-btn')?.addEventListener('click', async () => {
        const input = document.querySelector<HTMLInputElement>('#topup-amount');
        const statusEl = document.querySelector('#wallet-status');
        const amount = Number(input?.value ?? 0);
        if (!amount || amount < 1000) {
          if (statusEl) { statusEl.textContent = 'Ingresa un monto valido (min $1,000).'; statusEl.style.color = '#a40000'; }
          return;
        }

        const session = await ensureProviderSession({ redirectToLogin: true });
        if (!session.ok) return;

        const result = await apiRequest('/api/provider/wallet/topup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...providerAuthHeaders() },
          body: JSON.stringify({ amount })
        });

        if (result.ok) {
          if (input) input.value = '';
          if (statusEl) { statusEl.textContent = 'Saldo cargado.'; statusEl.style.color = '#0b5d1e'; }
          refreshWallet();
        } else {
          if (statusEl) { statusEl.textContent = 'Error al cargar saldo.'; statusEl.style.color = '#a40000'; }
        }
      });

      logoutButton?.addEventListener('click', () => {
        clearStoredAccessToken();
        if (metricNew) metricNew.textContent = '-';
        if (metricContacted) metricContacted.textContent = '-';
        if (metricQuoted) metricQuoted.textContent = '-';
        if (metricClosed) metricClosed.textContent = '-';
        window.location.href = '/panel/login';
      });

      refreshMetrics();
      refreshChecklist();
      refreshWallet();
    </script>
  </body>
</html>
