---
export const prerender = false;
import {
  providerTemplateInlineStyle,
  resolveProviderTemplateWithFallback
} from '../../scripts/provider-template';
import { getServiceName } from '../../data/catalog';

type ProviderProfileData = {
  id: string;
  slug: string;
  display_name: string;
  description: string | null;
  phone: string | null;
  whatsapp: string | null;
  website_url: string | null;
  logo_url: string | null;
  cover_url: string | null;
  template_id: string;
  custom_styles?: Record<string, string>;
  verified_at?: string | null;
  response_time_hours?: number | null;
  services: string[];
  city?: string;
  reviews?: { id: string; rating: number; title: string; body: string; status: string; created_at: string; author_label: string }[];
};

type PortfolioImage = { id: string; url: string; caption: string | null };

const slug = Astro.params.providerSlug ?? '';

let provider: ProviderProfileData | null = null;
let portfolioImages: PortfolioImage[] = [];
let errorMessage: string | null = null;

try {
  const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8787';
  const [provRes, portRes] = await Promise.all([
    fetch(`${apiBase}/api/providers/${encodeURIComponent(slug)}`),
    fetch(`${apiBase}/api/providers/${encodeURIComponent(slug)}/portfolio`)
  ]);
  if (provRes.ok) { const json = await provRes.json(); provider = json.data as ProviderProfileData; }
  if (portRes.ok) { const json = await portRes.json(); portfolioImages = (json.data ?? []) as PortfolioImage[]; }
} catch { errorMessage = 'Error al cargar datos del proveedor.'; }

const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';
const canonicalUrl = `${siteOrigin}/proveedores/${slug}`;
const template = provider
  ? resolveProviderTemplateWithFallback(provider.template_id)
  : resolveProviderTemplateWithFallback('craft-paper');

const customStyles = provider?.custom_styles ?? {};

const bodyStyle = [
  providerTemplateInlineStyle(template),
  customStyles.bgStart ? `background: linear-gradient(150deg, ${customStyles.bgStart}, ${customStyles.bgEnd || template.bgEnd}) !important;` : '',
  customStyles.textColor ? `color: ${customStyles.textColor} !important;` : '',
  customStyles.accentColor ? `--provider-accent: ${customStyles.accentColor};` : '',
  customStyles.bodyFont ? `font-family: ${customStyles.bodyFont};` : '',
  customStyles.headingFont ? `--provider-heading-font: ${customStyles.headingFont};` : '',
].filter(Boolean).join(' ');

const providerCity = provider?.city ?? 'bogota';

function formatWaNumber(phone: string): string {
  const digits = phone.replace(/\D/g, '');
  if (digits.startsWith('57')) return digits;
  if (digits.startsWith('+57')) return digits.slice(1);
  return '57' + digits;
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{provider ? `${provider.display_name} | Proveedor` : 'Proveedor no encontrado'} | Reindr Marketplace</title>
    <meta name="description" content={provider?.description ?? 'Perfil de proveedor en Reindr Marketplace.'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width" />
    <style is:inline>
      {customStyles.headingFont ? `h1, h2, h3 { font-family: ${customStyles.headingFont} !important; }` : ''}
      {customStyles.accentColor ? `h1, h2, h3, a { color: ${customStyles.accentColor} !important; }` : ''}
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      @media (max-width: 640px) {
        main { padding: 24px 12px !important; }
        h1 { font-size: 1.5rem; }
        img[style*="max-height:200px"] { max-height: 120px !important; }
      }
    </style>
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": provider?.display_name ?? '',
        "description": provider?.description ?? '',
        "url": canonicalUrl,
        "telephone": provider?.phone ?? undefined,
        "address": { "@type": "PostalAddress", "addressLocality": providerCity },
        "aggregateRating": provider?.rating_avg ? {
          "@type": "AggregateRating", "ratingValue": provider.rating_avg, "reviewCount": provider?.reviews_count ?? 0
        } : undefined
      })}
    </script>
  </head>
  <body style={bodyStyle}>
    <main
      data-provider-template={template.id}
      data-provider-slug={slug}
      style="max-width: 960px; margin: 0 auto; padding: 48px 20px; font-family: var(--provider-font);"
    >
      {!provider ? (
        <section>
          <a href="/servicios">&larr; Servicios</a>
          <h1>Proveedor no encontrado</h1>
          <p>{errorMessage ?? 'El proveedor que buscas no existe o no esta disponible.'}</p>
        </section>
      ) : (
        <>
          <a href="/servicios">&larr; Servicios</a>

          {provider.logo_url ? (
            <img src={provider.logo_url} alt={provider.display_name} style="max-width:120px; max-height:80px; border-radius:8px; margin:12px 0;" />
          ) : null}

          <h1>{provider.display_name}</h1>
          {provider.verified_at ? (
            <span style="display:inline-block; background:#0b5d1e; color:#fff; padding:3px 12px; border-radius:12px; font-size:12px; font-weight:600; margin-bottom:8px;">✅ Verificado</span>
          ) : null}
          <p>{provider.description}</p>

          {provider.cover_url ? (
            <img src={provider.cover_url} alt="" style="width:100%; max-height:200px; object-fit:cover; border-radius:12px; margin:12px 0;" loading="lazy" />
          ) : null}

          {provider.website_url ? (
            <p><strong>Sitio web:</strong> <a href={provider.website_url} rel="noopener" target="_blank">{provider.website_url.replace(/^https?:\/\//,'')}</a></p>
          ) : null}
          {provider.phone ? (
            <p><strong>Telefono:</strong> <a href={`tel:${provider.phone}`}>{provider.phone}</a></p>
          ) : null}
          {provider.whatsapp ? (
            <p><strong>WhatsApp:</strong> <a href={`https://wa.me/${formatWaNumber(provider.whatsapp)}`} target="_blank" rel="noopener">Enviar mensaje por WhatsApp</a></p>
          ) : null}

          {provider.response_time_hours != null ? (
            <p style="font-size:13px; opacity:0.7;">⏱ Responde en ~{provider.response_time_hours < 1 ? 'menos de 1 hora' : provider.response_time_hours.toFixed(0) + ' horas'}</p>
          ) : null}

          <nav style="margin-top:8px; font-size:12px; opacity:0.6;">
            <a href="/">Inicio</a> &rsaquo; <a href="/servicios">Servicios</a> &rsaquo; {provider.display_name}
          </nav>

          <section style="margin-top: 24px; border: 1px solid var(--provider-border); border-radius: 12px; padding: 14px; background: var(--provider-card-bg);">
            <h2>Servicios</h2>
            <ul>
              {provider.services?.map((serviceSlug: string) => (
                <li>
                  <a href={`/${providerCity}/${serviceSlug}`} style="color: var(--provider-accent);">{getServiceName(serviceSlug)}</a>
                </li>
              ))}
            </ul>
          </section>

          {portfolioImages.length > 0 ? (
            <section style="margin-top: 24px; border: 1px solid var(--provider-border); border-radius: 12px; padding: 14px; background: var(--provider-card-bg);">
              <h2>Galeria de trabajos</h2>
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px;">
                {portfolioImages.map((img) => (
                  <div>
                    <img src={img.url} alt={img.caption ?? ''} style="width:100%; height:140px; object-fit:cover; border-radius:8px;" loading="lazy" />
                    {img.caption ? <p style="font-size:12px; margin:4px 0 0; opacity:0.7;">{img.caption}</p> : null}
                  </div>
                ))}
              </div>
            </section>
          ) : null}

          <section style="margin-top: 24px; border: 1px solid var(--provider-border); border-radius: 12px; padding: 14px; background: var(--provider-card-bg);">
            <h2>Resenas verificadas</h2>
            {(provider.reviews?.filter((r: any) => r.status === 'approved') ?? []).length === 0 ? (
              <p>Este proveedor aun no tiene resenas publicadas.</p>
            ) : (
              <ul style="display: grid; gap: 12px; padding-left: 20px;">
                {provider.reviews?.filter((r: any) => r.status === 'approved').map((review: any) => (
                  <li>
                    <strong>{review.title}</strong> ({'★'.repeat(review.rating)}{'☆'.repeat(5 - review.rating)})
                    <p style="margin: 6px 0;">{review.body}</p>
                    <small>{review.author_label} - {new Date(review.created_at).toLocaleDateString('es-CO')}</small>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section style="margin-top: 24px; border: 1px solid var(--provider-border); border-radius: 12px; padding: 16px; background: var(--provider-card-bg);">
            <h2>Solicita cotizacion</h2>
            <p>Inicia por el servicio principal para enviar una sola solicitud y conectar servicios complementarios.</p>
            <a href={`/${providerCity}/${provider.services?.[0] ?? 'cajas-personalizadas'}`} style="color: var(--provider-accent);">Ir al formulario</a>
          </section>

          <section style="margin-top: 24px; border: 1px solid var(--provider-border); border-radius: 12px; padding: 16px; background: var(--provider-card-bg);">
            <h2>Dejar una resena</h2>
            <form id="review-form" style="display:grid; gap:8px;">
              <select id="review-rating" style="padding:6px; border:1px solid #ccc; border-radius:4px;">
                <option value="">Selecciona puntuacion</option>
                <option value="5">★★★★★ (5)</option>
                <option value="4">★★★★☆ (4)</option>
                <option value="3">★★★☆☆ (3)</option>
                <option value="2">★★☆☆☆ (2)</option>
                <option value="1">★☆☆☆☆ (1)</option>
              </select>
              <input id="review-title" placeholder="Titulo de tu resena" style="padding:8px; border:1px solid #ccc; border-radius:4px;" />
              <textarea id="review-body" placeholder="Cuenta tu experiencia..." rows="3" style="padding:8px; border:1px solid #ccc; border-radius:4px;"></textarea>
              <button type="submit" style="padding:8px 16px; background:#0b5d1e; color:#fff; border:none; border-radius:6px; cursor:pointer;">Enviar resena</button>
            </form>
            <p id="review-status" style="font-size:13px; margin:6px 0 0;"></p>
          </section>
        </>
      )}
    </main>

    <script is:inline>
      document.querySelector('#review-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rating = (document.querySelector('#review-rating') as HTMLSelectElement)?.value;
        const title = (document.querySelector('#review-title') as HTMLInputElement)?.value?.trim();
        const body = (document.querySelector('#review-body') as HTMLTextAreaElement)?.value?.trim();
        const status = document.querySelector('#review-status');
        if (!rating || !title || !body) {
          if (status) { status.textContent = 'Completa todos los campos.'; status.style.color = '#a40000'; }
          return;
        }
        const slug = window.location.pathname.split('/').pop();
        try {
          const res = await fetch('/api/providers/' + slug + '/reviews', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rating: Number(rating), title, body })
          });
          const json = await res.json();
          if (status) {
            status.textContent = json.ok ? 'Resena enviada. Gracias!' : (json.error?.message || 'Error');
            status.style.color = json.ok ? '#0b5d1e' : '#a40000';
          }
        } catch {
          if (status) { status.textContent = 'Error de conexion.'; status.style.color = '#a40000'; }
        }
      });
    </script>
  </body>
</html>
