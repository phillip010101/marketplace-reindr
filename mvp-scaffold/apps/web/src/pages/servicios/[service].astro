---
export const prerender = false;
import { getServiceBySlug } from '../../data/catalog';

type ProviderCard = {
  id: string;
  slug: string;
  display_name: string;
  description: string;
  template_id: string;
};

const { service } = Astro.params;
const serviceSlug = (service ?? 'cajas-personalizadas').toLowerCase();
const serviceItem = getServiceBySlug(serviceSlug);
const serviceName = serviceItem?.name ?? serviceSlug;

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8787';

let providers: ProviderCard[] = [];

try {
  const res = await fetch(`${apiBaseUrl}/api/providers?city=bogota&service=${encodeURIComponent(serviceSlug)}`);
  if (res.ok) {
    const json = await res.json();
    providers = (json.data ?? []) as ProviderCard[];
  }
} catch {
  // Empty fallback
}

const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';
const canonicalUrl = `${siteOrigin}/servicios/${serviceSlug}`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{serviceName} | Reindr Marketplace</title>
    <meta name="description" content={`Explora proveedores y contexto para ${serviceName}.`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main style="max-width: 960px; margin: 0 auto; padding: 48px 20px; font-family: system-ui, sans-serif;">
      <a href="/servicios">&larr; Todos los servicios</a>
      <h1>{serviceName}</h1>
      <p>{serviceItem?.description ?? 'Servicio en catalogo.'}</p>

      <section style="margin-top: 24px;">
        <h2>Ciudad activa</h2>
        <p>
          <a href={`/bogota/${serviceSlug}`}>Ver {serviceName} en Bogota</a>
        </p>
      </section>

      <section style="margin-top: 24px;">
        <h2>Proveedores en Bogota</h2>
        {providers.length === 0 ? (
          <p style="color:var(--color-text-muted);">📭 Este servicio aun no tiene proveedores activos publicados.</p>
        ) : (
          <div style="display:grid; gap:12px; margin-top:8px;">
            {providers.map((p) => (
              <a href={`/proveedores/${p.slug}`} style="background:#fff; border:1px solid #ddd; border-radius:12px; padding:16px; text-decoration:none; color:inherit; display:block; transition:box-shadow .15s;">
                <strong style="font-size:var(--text-lg);">{p.display_name}</strong>
                {p.description ? <p style="margin:4px 0 0; opacity:0.7; font-size:14px;">{p.description.slice(0, 120)}</p> : null}
              </a>
            ))}
          </div>
        )}
      </section>
    </main>
  </body>
</html>
