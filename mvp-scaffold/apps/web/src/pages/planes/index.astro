---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout title="Planes para proveedores" description="Elige el plan que mejor se adapte a tu negocio. Todos los planes incluyen perfil publico y recepcion de leads.">
  <main style="max-width:1000px; margin:0 auto; padding:48px 20px;">
    <h1>Planes para proveedores</h1>
    <p style="color:var(--color-text-muted); max-width:600px;">Elige el plan que mejor se adapte a tu negocio.</p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px; margin-top:32px;">
      <div class="card" style="text-align:center; padding:28px;">
        <h2 style="margin:0;">Gratuito</h2>
        <p style="font-size:36px; margin:16px 0 4px; font-weight:700;">$0</p>
        <p style="color:var(--color-text-muted); margin:0 0 20px;">para siempre</p>
        <ul style="text-align:left; padding-left:20px; line-height:2; font-size:var(--text-sm);">
          <li>1 pagina de perfil</li><li>6 plantillas basicas</li><li>Hasta 3 servicios</li>
          <li>1 ciudad</li><li>10 leads gratis/mes</li><li>Subdominio apps.reindr.org</li>
        </ul>
        <a href="/panel/registro" class="btn btn-primary" style="display:block; margin-top:20px;">Comenzar gratis</a>
      </div>

      <div class="card" style="text-align:center; padding:28px; border:2px solid var(--color-brand); box-shadow:var(--shadow-hover);">
        <span style="background:var(--color-brand); color:#fff; padding:4px 12px; border-radius:var(--radius-full); font-size:var(--text-xs); font-weight:600;">MAS POPULAR</span>
        <h2 style="margin:10px 0 0;">Pro Mensual</h2>
        <p style="font-size:36px; margin:16px 0 4px; font-weight:700;">$49.900</p>
        <p style="color:var(--color-text-muted); margin:0 0 20px;">/mes</p>
        <ul style="text-align:left; padding-left:20px; line-height:2; font-size:var(--text-sm);">
          <li>Todo lo del plan Gratuito</li><li>14 plantillas + personalizacion</li>
          <li>Servicios ilimitados</li><li>Ciudades ilimitadas</li>
          <li>Leads ilimitados</li><li>Custom domain (proximamente)</li>
        </ul>
        <a href="/panel/plan" class="btn btn-primary" style="display:block; margin-top:20px;">Actualizar a Pro</a>
      </div>

      <div class="card" style="text-align:center; padding:28px;">
        <h2 style="margin:0;">Pro Anual</h2>
        <p style="font-size:36px; margin:16px 0 4px; font-weight:700;">$499.000</p>
        <p style="color:var(--color-text-muted); margin:0 0 20px;">/ano (2 meses gratis)</p>
        <ul style="text-align:left; padding-left:20px; line-height:2; font-size:var(--text-sm);">
          <li>Todo lo de Pro Mensual</li><li>Custom domain incluido</li>
          <li>Badge "Verificado"</li><li>Prioridad en busquedas</li>
        </ul>
        <a href="/panel/plan" class="btn btn-primary" style="display:block; margin-top:20px;">Actualizar a Pro Anual</a>
      </div>
    </div>
  </main>
</BaseLayout>
