---
export const prerender = false;
import { getServiceBySlug, getServiceName } from '../../data/catalog';

type ProviderCard = {
  id: string; slug: string; display_name: string; description: string;
  services: string[]; city: string; template_id: string;
};
type RelatedService = { slug: string; label: string };
type CityItem = { id: string; slug: string; name: string };

const { city, service } = Astro.params;
const citySlug = (city ?? 'bogota').toLowerCase();
const serviceSlug = (service ?? 'cajas-personalizadas').toLowerCase();

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8787';
const leadsEndpoint = `${apiBaseUrl}/api/leads`;

const serviceItem = getServiceBySlug(serviceSlug);
const serviceName = serviceItem?.name ?? getServiceName(serviceSlug);

let providers: ProviderCard[] = [];
let related: RelatedService[] = [];
const cities: CityItem[] = [
  { id: 'bogota', slug: 'bogota', name: 'Bogotá' },
  { id: 'medellin', slug: 'medellin', name: 'Medellín' },
  { id: 'cali', slug: 'cali', name: 'Cali' },
  { id: 'barranquilla', slug: 'barranquilla', name: 'Barranquilla' }
];

try {
  const [provRes, relRes] = await Promise.all([
    fetch(`${apiBaseUrl}/api/providers?city=${encodeURIComponent(citySlug)}&service=${encodeURIComponent(serviceSlug)}`),
    fetch(`${apiBaseUrl}/api/services/${encodeURIComponent(serviceSlug)}/related`)
  ]);
  if (provRes.ok) { const json = await provRes.json(); providers = (json.data ?? []) as ProviderCard[]; }
  if (relRes.ok) {
    const json = await relRes.json();
    related = (json.data ?? []).map((r: any) => ({ slug: r.slug ?? r.target_service_slug, label: r.name ?? r.label ?? r.target_service_name ?? r.slug }));
  }
} catch { /* fallback */ }

const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';
const canonicalUrl = `${siteOrigin}/${citySlug}/${serviceSlug}`;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{serviceName} en {citySlug} | Solicita cotizaciones</title>
    <meta name="description" content={`Encuentra proveedores de ${serviceName} en ${citySlug} y solicita servicios relacionados.`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width" />
    <style>
      .stepper { display:flex; gap:0; margin-bottom:20px; }
      .step-dot { flex:1; text-align:center; padding:8px; font-size:13px; border-bottom:3px solid #ddd; opacity:0.5; }
      .step-dot.active { border-color:#0b5d1e; opacity:1; font-weight:600; }
      .step-dot.done { border-color:#4ecca3; opacity:0.8; }
      .field-error { color:#a40000; font-size:12px; margin-top:2px; display:none; }
      input:invalid, textarea:invalid { border-color:#a40000; }
    </style>
  </head>
  <body>
    <main style="max-width: 960px; margin: 0 auto; padding: 48px 20px; font-family: system-ui, sans-serif;">
      <nav style="font-size:12px; opacity:0.6; margin-bottom:16px;">
        <a href="/">Inicio</a> &rsaquo; <a href={`/${citySlug}`}>{citySlug}</a> &rsaquo; {serviceName}
      </nav>
      <h1>{serviceName} en {citySlug}</h1>
      <p>{serviceItem?.description ?? 'Solicita cotizaciones y anade servicios complementarios para tu proyecto.'}</p>

      <section style="margin-top: 24px;">
        <h2>Proveedores disponibles</h2>
        {providers.length === 0 ? (
          <p>Aun no hay proveedores activos para este servicio en esta ciudad.</p>
        ) : (
          <ul>
            {providers.map((p) => (
              <li><a href={`/proveedores/${p.slug}`}>{p.display_name}</a></li>
            ))}
          </ul>
        )}
      </section>

      <section style="margin-top: 32px; border: 1px solid #ddd; border-radius: 16px; padding: 20px;">
        <h2>Solicitar cotizacion</h2>

        <div class="stepper" id="stepper">
          <div class="step-dot active" data-step="1">Paso 1<br>Necesidad</div>
          <div class="step-dot" data-step="2">Paso 2<br>Servicios</div>
          <div class="step-dot" data-step="3">Paso 3<br>Contacto</div>
        </div>

        <form id="lead-form" method="post" action={leadsEndpoint} style="display: grid; gap: 12px;">
          <input name="city_slug" id="city-slug-input" value={citySlug} type="hidden" />
          <input name="primary_service_slug" value={serviceSlug} type="hidden" />

          <div data-step="1">
            <h3>Describe tu necesidad</h3>
            <label>Ciudad
              <select name="city_selector" id="city-selector" style="width:100%; padding:8px; margin-bottom:8px;">
                {cities.map(c => (
                  <option value={c.slug} selected={c.slug === citySlug}>{c.name}</option>
                ))}
              </select>
            </label>
            <textarea name="description" id="desc-field" placeholder="Cuentanos que necesitas: tipo de empaque, cantidad, material, plazo..." rows="4" required style="width:100%; padding:8px; box-sizing:border-box;"></textarea>
            <p class="field-error" id="desc-error">Describe tu necesidad (minimo 10 caracteres).</p>
            <div style="display:flex; justify-content:flex-end; margin-top:8px;">
              <button type="button" data-next-step="2" style="padding:10px 20px;">Continuar</button>
            </div>
          </div>

          <div data-step="2" hidden>
            <h3>Servicios relacionados</h3>
            {related.length === 0 ? (
              <p>No hay servicios relacionados disponibles.</p>
            ) : (
              <fieldset>
                <legend>Este proyecto tambien puede necesitar:</legend>
                {related.map((item) => (
                  <label style="display: block; margin:4px 0;">
                    <input type="checkbox" name="requested_service_slugs" value={item.slug} />
                    {item.label}
                  </label>
                ))}
              </fieldset>
            )}
            <div style="display:flex; justify-content:space-between; gap:8px; margin-top:12px;">
              <button type="button" data-prev-step="1">Volver</button>
              <button type="button" data-next-step="3" style="padding:10px 20px;">Continuar</button>
            </div>
          </div>

          <div data-step="3" hidden>
            <h3>Datos de contacto</h3>
            <input name="client_name" id="name-field" placeholder="Tu nombre completo" required style="width:100%; padding:8px; box-sizing:border-box;" />
            <p class="field-error" id="name-error">Ingresa tu nombre.</p>
            <input name="client_email" id="email-field" type="email" placeholder="Email" required style="width:100%; padding:8px; box-sizing:border-box;" />
            <p class="field-error" id="email-error">Ingresa un email valido.</p>
            <input name="client_phone" id="phone-field" placeholder="WhatsApp o telefono" required style="width:100%; padding:8px; box-sizing:border-box;" />
            <p class="field-error" id="phone-error">Ingresa un telefono de contacto.</p>
            <select name="urgency" style="width:100%; padding:8px;">
              <option value="">Urgencia (opcional)</option>
              <option value="this_week">Esta semana</option>
              <option value="this_month">Este mes</option>
            </select>
            <select name="budget_range" style="width:100%; padding:8px;">
              <option value="">Presupuesto aproximado (opcional)</option>
              <option value="0-500k">Menos de $500.000</option>
              <option value="500k-2M">$500.000 - $2.000.000</option>
              <option value="2M-5M">$2.000.000 - $5.000.000</option>
              <option value="5M+">Mas de $5.000.000</option>
            </select>

            <label style="font-size:13px; display:flex; align-items:flex-start; gap:6px; margin-top:8px;">
              <input type="checkbox" name="consent" id="consent-check" required />
              <span>Acepto ser contactado por proveedores.</span>
            </label>
            <p class="field-error" id="consent-error">Debes aceptar ser contactado.</p>

            <div style="display:flex; justify-content:space-between; gap:8px; margin-top:12px;">
              <button type="button" data-prev-step="2">Volver</button>
              <button type="submit" style="padding:10px 24px; background:#0b5d1e; color:#fff; border:none; border-radius:6px; cursor:pointer; font-size:15px;">Enviar solicitud</button>
            </div>
          </div>
        </form>
      </section>
    </main>

    <script is:inline>
      const form = document.querySelector('#lead-form');
      const stepper = document.querySelector('#stepper');
      const citySelector = document.querySelector('#city-selector');
      const citySlugInput = document.querySelector('#city-slug-input');
      let currentStep = 1;

      function updateStepper(step: number) {
        if (!stepper) return;
        stepper.querySelectorAll('.step-dot').forEach(d => {
          const s = Number(d.getAttribute('data-step'));
          d.className = 'step-dot' + (s === step ? ' active' : s < step ? ' done' : '');
        });
      }

      function showStep(n: number) {
        form?.querySelectorAll('[data-step]').forEach(el => {
          el.hidden = el.getAttribute('data-step') !== String(n);
        });
        currentStep = n;
        updateStepper(n);
      }

      function hideError(id: string) { const el = document.querySelector('#' + id); if (el) el.style.display = 'none'; }
      function showError(id: string) { const el = document.querySelector('#' + id); if (el) el.style.display = 'block'; }

      function validateStep1(): boolean {
        const desc = (document.querySelector('#desc-field') as HTMLTextAreaElement)?.value?.trim() ?? '';
        if (desc.length < 10) { showError('desc-error'); return false; }
        hideError('desc-error'); return true;
      }

      function validateStep3(): boolean {
        let ok = true;
        const name = (document.querySelector('#name-field') as HTMLInputElement)?.value?.trim() ?? '';
        const email = (document.querySelector('#email-field') as HTMLInputElement)?.value?.trim() ?? '';
        const phone = (document.querySelector('#phone-field') as HTMLInputElement)?.value?.trim() ?? '';
        const consent = (document.querySelector('#consent-check') as HTMLInputElement)?.checked ?? false;

        if (!name) { showError('name-error'); ok = false; } else hideError('name-error');
        if (!email || !email.includes('@')) { showError('email-error'); ok = false; } else hideError('email-error');
        if (!phone) { showError('phone-error'); ok = false; } else hideError('phone-error');
        if (!consent) { showError('consent-error'); ok = false; } else hideError('consent-error');
        return ok;
      }

      citySelector?.addEventListener('change', () => {
        if (citySlugInput) citySlugInput.value = citySelector.value;
      });

      form?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;

        const next = target.getAttribute('data-next-step');
        if (next) {
          if (currentStep === 1 && !validateStep1()) return;
          showStep(Number(next));
          return;
        }

        const prev = target.getAttribute('data-prev-step');
        if (prev) { showStep(Number(prev)); }
      });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!validateStep3()) return;

        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }

        const data = new FormData(form);
        const body = new URLSearchParams();
        for (const [key, val] of data.entries()) {
          if (key === 'requested_service_slugs') body.append(key, String(val));
          else body.set(key, String(val));
        }

        try {
          const res = await fetch(form.getAttribute('action') ?? '/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
          });
          const json = await res.json();
          if (json.ok && json.data) {
            const code = json.data.lead_public_code ?? '';
            const opps = json.data.opportunities_count ?? 0;
            window.location.href = `/confirmacion?code=${encodeURIComponent(code)}&opportunities=${opps}`;
          }
        } catch {
          if (btn) { btn.disabled = false; btn.textContent = 'Enviar solicitud'; }
        }
      });

      updateStepper(1);
    </script>
  </body>
</html>
