---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = false;

type PublicServiceItem = { id: string; slug: string; name: string; description: string; status: string };
type ProviderItem = { id: string; slug: string; display_name: string; description: string; template_id: string };

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8787';
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';

let services: PublicServiceItem[] = [];
let providers: ProviderItem[] = [];
let heroTitle = 'Red de servicios conectados';
let heroSubtitle = 'Encuentra proveedores y arma solicitudes multi-servicio';

try {
  const [svcRes, provRes, titleRes, subRes] = await Promise.all([
    fetch(`${apiBase}/api/services`),
    fetch(`${apiBase}/api/providers?city=bogota`),
    fetch(`${apiBase}/api/content/home-hero-title`),
    fetch(`${apiBase}/api/content/home-hero-subtitle`)
  ]);
  if (svcRes.ok) { const json = await svcRes.json(); services = (json.data ?? []) as PublicServiceItem[]; }
  if (provRes.ok) { const json = await provRes.json(); providers = (json.data ?? []).slice(0, 3) as ProviderItem[]; }
  if (titleRes.ok) { const json = await titleRes.json(); if (json.data?.value) heroTitle = json.data.value; }
  if (subRes.ok) { const json = await subRes.json(); if (json.data?.value) heroSubtitle = json.data.value; }
} catch { /* fallback */ }
---

<BaseLayout title="Inicio" description={heroSubtitle} canonicalUrl={`${siteOrigin}/`}>
  <main style="max-width:960px; margin:0 auto; padding:48px 20px;">
    <section>
      <p style="text-transform:uppercase; letter-spacing:.08em; font-size:12px; color:var(--color-text-muted);">Marketplace local de servicios</p>
      <h1>{heroTitle}</h1>
      <p style="font-size:var(--text-lg); color:var(--color-text-muted);">{heroSubtitle}</p>

      <form id="search-form" style="display:flex; gap:8px; flex-wrap:wrap; margin-top:24px;">
        <input class="input" id="search-input" placeholder="Que necesitas? Ej: cajas personalizadas" style="max-width:400px;" />
        <button type="submit" class="btn btn-primary" id="search-btn">Buscar</button>
      </form>
      <p style="margin-top:16px;">
        <a href="/panel/registro" class="btn btn-primary">Ofrece tus servicios — Registra tu negocio</a>
      </p>
    </section>

    <section style="margin-top:48px;">
      <h2>Servicios disponibles</h2>
      <p><a href="/servicios">Ver todos los servicios ({services.length})</a></p>
      <div style="display:grid; gap:12px; grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
        {services.slice(0, 6).map(s => (
          <a href={`/bogota/${s.slug}`} class="card" style="text-decoration:none; color:inherit;">
            <strong>{s.name}</strong>
            <p style="font-size:var(--text-sm); color:var(--color-text-muted); margin:4px 0 0;">Ver proveedores en Bogota</p>
          </a>
        ))}
      </div>
    </section>

    {providers.length > 0 ? (
      <section style="margin-top:48px;">
        <h2>Proveedores destacados</h2>
        <div style="display:grid; gap:12px; grid-template-columns:repeat(auto-fit,minmax(240px,1fr));">
          {providers.map(p => (
            <a href={`/proveedores/${p.slug}`} class="card" style="text-decoration:none; color:inherit;">
              <strong>{p.display_name}</strong>
              <p style="font-size:var(--text-sm); color:var(--color-text-muted);">{p.description?.slice(0, 100)}</p>
            </a>
          ))}
        </div>
      </section>
    ) : null}
  </main>

  <script id="service-data" type="application/json">{JSON.stringify(services.map(s => ({ slug: s.slug, name: s.name })))}</script>
  <script is:inline>
    document.querySelector('#search-form')?.addEventListener('submit', e => {
      e.preventDefault();
      const q = (document.querySelector('#search-input') as HTMLInputElement)?.value?.trim().toLowerCase() ?? '';
      if (!q) return;
      const data = JSON.parse(document.querySelector('#service-data')?.textContent ?? '[]');
      for (const s of data) {
        if (s.slug.includes(q) || s.name.toLowerCase().includes(q)) { window.location.href = '/bogota/' + s.slug; return; }
      }
      window.location.href = '/servicios';
    });
  </script>
</BaseLayout>
