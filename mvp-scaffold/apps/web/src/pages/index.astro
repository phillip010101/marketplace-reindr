---
export const prerender = false;

type ServiceItem = { id: string; slug: string; name: string; description: string; status: string };
type ProviderItem = { id: string; slug: string; display_name: string; description: string; template_id: string };

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8787';
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';

let services: ServiceItem[] = [];
let providers: ProviderItem[] = [];

try {
  const [svcRes, provRes] = await Promise.all([
    fetch(`${apiBase}/api/services`),
    fetch(`${apiBase}/api/providers?city=bogota`)
  ]);
  if (svcRes.ok) {
    const json = await svcRes.json();
    services = (json.data ?? []).filter((s: ServiceItem) => s.status === 'active');
  }
  if (provRes.ok) {
    const json = await provRes.json();
    providers = (json.data ?? []).slice(0, 3) as ProviderItem[];
  }
} catch { /* static fallback */ }
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Red de servicios conectados | Reindr Marketplace</title>
    <meta name="description" content="Encuentra proveedores y solicita cotizaciones para servicios relacionados en tu ciudad." />
    <link rel="canonical" href={`${siteOrigin}/`} />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main style="max-width: 960px; margin: 0 auto; padding: 48px 20px; font-family: system-ui, sans-serif;">
      <section>
        <p style="text-transform: uppercase; letter-spacing: .08em; font-size: 12px;">Marketplace local de servicios</p>
        <h1>Encuentra proveedores y arma solicitudes multi-servicio</h1>
        <p>Busca un servicio principal y anade servicios complementarios como diseno, troquel, impresion, etiquetas o ecommerce.</p>

        <form action="/bogota/cajas-personalizadas" method="get" style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 24px;">
          <input name="q" placeholder="Que necesitas?" style="padding: 12px; min-width: 240px;" />
          <button style="padding: 12px 16px;">Buscar</button>
        </form>
      </section>

      <section style="margin-top: 48px;">
        <h2>Servicios disponibles</h2>
        <p><a href="/servicios">Ver todos los servicios ({services.length})</a></p>
        <div style="display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
          {services.slice(0, 6).map((service) => (
            <a href={`/bogota/${service.slug}`} style="border: 1px solid #ddd; border-radius: 12px; padding: 16px; text-decoration: none; color: inherit;">
              <strong>{service.name}</strong>
              <p>Ver proveedores en Bogota</p>
            </a>
          ))}
        </div>
      </section>

      {providers.length > 0 ? (
        <section style="margin-top: 48px;">
          <h2>Proveedores destacados</h2>
          <div style="display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
            {providers.map((p) => (
              <a href={`/proveedores/${p.slug}`} style="border: 1px solid #ddd; border-radius: 12px; padding: 16px; text-decoration: none; color: inherit;">
                <strong>{p.display_name}</strong>
                <p style="font-size:14px; opacity:0.7;">{p.description?.slice(0, 100)}</p>
              </a>
            ))}
          </div>
        </section>
      ) : null}
    </main>
  </body>
</html>
