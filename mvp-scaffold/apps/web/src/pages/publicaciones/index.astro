---
export const prerender = false;

type PostItem = {
  id: string; title: string; slug: string; description: string | null;
  status: string; tags: string[] | null; published_at: string; created_at: string;
};

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8787';
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';

let posts: PostItem[] = [];
try {
  const res = await fetch(`${apiBase}/api/posts`);
  if (res.ok) { const json = await res.json(); posts = (json.data ?? []) as PostItem[]; }
} catch { /* empty */ }
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Publicaciones | Reindr Marketplace</title>
    <meta name="description" content="Guias, comparativas y tutoriales sobre servicios de empaque, impresion, troqueles y mas." />
    <link rel="canonical" href={`${siteOrigin}/publicaciones`} />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main style="max-width: 800px; margin: 0 auto; padding: 48px 20px; font-family: system-ui, sans-serif;">
      <a href="/">&larr; Inicio</a>
      <h1>Publicaciones</h1>
      <p style="opacity:0.7;">Guias, comparativas y tutoriales para tomar mejores decisiones sobre tus empaques.</p>

      <div style="margin-top: 32px; display: grid; gap: 20px;">
        {posts.length === 0 ? (
          <p>No hay publicaciones disponibles.</p>
        ) : (
          posts.map((post) => (
            <article style="border: 1px solid #ddd; border-radius: 12px; padding: 20px;">
              <p style="margin:0; font-size:12px; opacity:0.5; text-transform:uppercase; letter-spacing:.05em;">
                {post.published_at ? new Date(post.published_at).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
              </p>
              <h2 style="margin:6px 0;">
                <a href={`/publicaciones/${post.slug}`} style="color:inherit; text-decoration:none;">{post.title}</a>
              </h2>
              <p style="opacity:0.7;">{post.description}</p>
              <p style="font-size:13px;">
                {(post.tags ?? []).map((tag: string) => (
                  <span style="background:#f0f0f0; padding:2px 8px; border-radius:4px; margin-right:6px;">{tag}</span>
                ))}
              </p>
              <a href={`/publicaciones/${post.slug}`}>Leer mas</a>
            </article>
          ))
        )}
      </div>
    </main>
  </body>
</html>
