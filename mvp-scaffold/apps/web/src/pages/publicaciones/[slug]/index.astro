---
export const prerender = false;

type PostItem = {
  id: string; title: string; slug: string; description: string | null;
  body: string; status: string; tags: string[] | null;
  published_at: string; created_at: string;
};

const { slug } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8787';
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';

let post: PostItem | null = null;

try {
  const res = await fetch(`${apiBase}/api/posts/${encodeURIComponent(slug ?? '')}`);
  if (res.ok) { const json = await res.json(); post = json.data as PostItem; }
} catch { /* fallback */ }

if (!post) {
  return new Response('<html><body><h1>Publicacion no encontrada</h1><a href="/publicaciones">Volver</a></body></html>', { status: 404, headers: { 'Content-Type': 'text/html' } });
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{post.title} | Reindr Marketplace</title>
    <meta name="description" content={post.description ?? post.title} />
    <link rel="canonical" href={`${siteOrigin}/publicaciones/${post.slug}`} />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main style="max-width: 800px; margin: 0 auto; padding: 48px 20px; font-family: system-ui, sans-serif; line-height: 1.7;">
      <a href="/publicaciones">&larr; Publicaciones</a>
      <article style="margin-top: 24px;">
        <p style="font-size:12px; opacity:0.5; text-transform:uppercase; letter-spacing:.05em;">
          {post.published_at ? new Date(post.published_at).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
        </p>
        <h1>{post.title}</h1>
        <div style="white-space:pre-wrap;">{post.body}</div>
      </article>
    </main>
  </body>
</html>
