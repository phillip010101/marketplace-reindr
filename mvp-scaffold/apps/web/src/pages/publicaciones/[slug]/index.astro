---
export const prerender = false;
import { getCollection, render } from 'astro:content';

const { slug } = Astro.params;
const posts = await getCollection('posts');
const post = posts.find((p) => p.id === slug);

if (!post) {
  return new Response('Publicacion no encontrada', { status: 404, headers: { 'Content-Type': 'text/html' } });
}

const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://apps.reindr.org';
const { Content } = await render(post);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{post.data.title} | Reindr Marketplace</title>
    <meta name="description" content={post.data.description} />
    <link rel="canonical" href={`${siteOrigin}/publicaciones/${post.id}`} />
    <meta name="viewport" content="width=device-width" />
  </head>
  <body>
    <main style="max-width: 800px; margin: 0 auto; padding: 48px 20px; font-family: system-ui, sans-serif; line-height: 1.7;">
      <a href="/publicaciones">&larr; Publicaciones</a>
      <article style="margin-top: 24px;">
        <p style="font-size:12px; opacity:0.5; text-transform:uppercase; letter-spacing:.05em;">
          {post.data.pubDate.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
        <h1>{post.data.title}</h1>
        <div>
          <Content />
        </div>
      </article>
      <footer style="margin-top: 48px; padding-top: 20px; border-top:1px solid #ddd; font-size:14px; opacity:0.7;">
        <a href="/servicios">Ver todos los servicios</a> · <a href="/publicaciones">Mas publicaciones</a>
      </footer>
    </main>
  </body>
</html>
